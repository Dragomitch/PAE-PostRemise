{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration=development-en",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "npm run i18n:check && ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "i18n:extract": "ng extract-i18n",
    "i18n:check": "node scripts/check-i18n.mjs",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:generate": "openapi-ts",
    "api:check": "node scripts/check-openapi-client.mjs",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/router": "^20.3.35",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.35",
    "@angular/localize": "^20.3.35",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "karma-junit-reporter": "^2.0.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "piscina": "^5.3.2",
    "js-yaml": "^4.3.2"
  }
}
