# Editor configuration, see https://editorconfig.org
# Completes the repository's /.editorconfig (UTF-8, LF, 2 spaces, final newline); Prettier
# (.prettierrc, npm run format) has the last word on the layout of the files it formats.

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.md]
max_line_length = off
trim_trailing_whitespace = false
