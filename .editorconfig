# Editor configuration, see https://editorconfig.org
# The basics the formatters also apply: google-java-format for Java (mvn spotless:apply) and
# Prettier for the Angular app (npm run format in frontend/), which have the last word on layout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[pom.xml]
indent_size = 4
