<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.dragomitch.ipl.pae</groupId>
    <artifactId>PAE-Gestionnaire-Erasmus</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Generic properties -->
        <java.version>21</java.version>
        <jacoco.version>0.8.16</jacoco.version>
        <embedded-postgres.version>2.2.2</embedded-postgres.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- Formatting (spotless:check in verify): google-java-format, the style of backend/AGENTS.md -->
        <spotless.version>3.11.0</spotless.version>
        <google-java-format.version>2.0.0</google-java-format.version>
        <!-- OpenAPI 3 document (/v3/api-docs) and Swagger UI (/swagger-ui.html): the 3.x line is the
             one built for Spring Boot 4 / Spring Framework 7 (Spring Boot does not manage it) -->
        <springdoc.version>3.2.0</springdoc.version>
        <!-- PostgreSQL 18 binaries used by the repository integration tests (*IT): the major of
             the postgres image in docker-compose.yml -->
        <embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
        <!-- Filled in by jacoco:prepare-agent; declared empty so @{argLine} always resolves -->
        <argLine></argLine>
        <!-- JaCoCo regression gates on the merged unit + integration coverage (jacoco:check in
             verify). Set just below the level reached (lines 99.1%, branches 91.7% with the unit
             tests of the use-case services; JDBC DAOs 100% / 98.4%; use cases 99.5% / 97.8%).
             Raise them as coverage grows; do not lower them to get a change merged. Nothing is
             excluded from the analysis. -->
        <jacoco.minimum.line>0.98</jacoco.minimum.line>
        <jacoco.minimum.branch>0.91</jacoco.minimum.branch>
        <jacoco.minimum.persistence.line>0.98</jacoco.minimum.persistence.line>
        <jacoco.minimum.persistence.branch>0.98</jacoco.minimum.persistence.branch>
        <jacoco.minimum.usecases.line>0.98</jacoco.minimum.usecases.line>
        <jacoco.minimum.usecases.branch>0.97</jacoco.minimum.usecases.branch>
        <!-- Fixed locale/time zone for every forked test JVM (unit and integration) -->
        <test.jvm.args>-Duser.timezone=UTC -Duser.language=en -Duser.country=US -Dfile.encoding=UTF-8</test.jvm.args>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!--All dependencies to put here, including module dependencies-->
        <!-- Test starters: each one brings spring-boot-starter-test (JUnit, Mockito, AssertJ,
             spring-test). webmvc-test adds @WebMvcTest, MockMvc and RestTestClient; the security
             one adds spring-security-test and the auto-configuration that puts the real security
             filter chain in @WebMvcTest and MockMvc tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchitectureTest: the hexagonal layering (ADR 0001) fails the build when broken -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.postgresql/postgresql -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Stateless authentication: the session JWT is validated as an OAuth2 bearer token -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Spring Boot dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- /actuator/health (with the database indicator) and /actuator/info: the health check of the
             backend container in docker-compose.yml; nothing else is exposed (application.properties) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Persistence: Spring Data JPA (Hibernate) behind the outbound ports (adapter.out.persistence) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Schema migrations: Flyway runs src/main/resources/db/migration at start-up, before
             Hibernate (ADR 0003). The starter brings flyway-core and Spring Boot's auto-configuration;
             PostgreSQL support is a separate Flyway module. Versions managed by Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Bean Validation (Hibernate Validator): request bodies, parameters and use-case methods -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- IDE metadata (META-INF/spring-configuration-metadata.json) for the app.* properties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI 3 document of the controllers and Swagger UI (OpenApiConfig) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Real PostgreSQL (no Docker) for the DAO integration tests -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>${embedded-postgres.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- embedded-postgres only bundles x86-64 binaries: add the Apple Silicon ones for local runs -->
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!-- Legacy web UI, served by Spring Boot as static content -->
            <resource>
                <directory>${project.basedir}/src/main/webapp</directory>
                <targetPath>static</targetPath>
                <excludes>
                    <exclude>WEB-INF/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!-- Unit tests (*Test, Test*, *Tests): fixed locale/time zone, JaCoCo agent via @{argLine} -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${test.jvm.args}</argLine>
                </configuration>
            </plugin>
            <!--
              Code coverage. One agent (prepare-agent sets argLine) instruments both the unit tests
              (surefire) and the integration tests (failsafe); both append to target/jacoco.exec,
              so the report in target/site/jacoco (XML read by CI) is the merged unit + integration
              coverage. The report and check executions are declared before failsafe so that, in
              the verify phase, the report is still written when an integration test fails.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Thresholds: jacoco.minimum.* properties above. The second rule
                                 guards the persistence adapters (covered by the *IT tests). The
                                 third one guards the business rules of the use-case services
                                 (covered by the unit tests). -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.dragomitch.ipl.pae.adapter.out.persistence</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.persistence.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.persistence.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.dragomitch.ipl.pae.application</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.usecases.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.usecases.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Integration tests (*IT): DAOs against an embedded PostgreSQL, reported in
                 target/failsafe-reports (the "Backend integration" suite of the CI report) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${test.jvm.args}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Spring Boot Maven plugin. build-info writes META-INF/build-info.properties, read as
                 BuildProperties: the version of the OpenAPI document and of /actuator/info. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Formatting: google-java-format on the main and test sources. spotless:check runs in
                 the verify phase, so `mvn verify` (CI) fails on a misformatted file; run
                 `mvn spotless:apply` to fix it. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
