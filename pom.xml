<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>
    <groupId>com.dragomitch.ipl.pae</groupId>
    <artifactId>PAE-Gestionnaire-Erasmus</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Generic properties -->
        <java.version>21</java.version>
        <jacoco.version>0.8.12</jacoco.version>
        <embedded-postgres.version>2.2.2</embedded-postgres.version>
        <!-- PostgreSQL 16 binaries used by the DAO integration tests (*IT) -->
        <embedded-postgres-binaries.version>16.15.0</embedded-postgres-binaries.version>
        <!-- embedded-postgres 2.2 calls commons-lang3 3.18+ APIs; Spring Boot 3.2 manages 3.13.
             Only the tests use commons-lang3 (see mvn dependency:tree). -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <!-- Filled in by jacoco:prepare-agent; declared empty so @{argLine} always resolves -->
        <argLine></argLine>
        <!-- JaCoCo regression gates on the merged unit + integration coverage (jacoco:check in
             verify). Set just below the level reached (lines 89.1%, branches 69.3% after the
             problem details / Bean Validation change, which removed the hand-written checks; JDBC
             DAOs 98.5% / 98.1%). Raise them as coverage grows; do not lower them to get a change
             merged. Nothing is excluded from the analysis. -->
        <jacoco.minimum.line>0.88</jacoco.minimum.line>
        <jacoco.minimum.branch>0.69</jacoco.minimum.branch>
        <jacoco.minimum.persistence.line>0.98</jacoco.minimum.persistence.line>
        <jacoco.minimum.persistence.branch>0.98</jacoco.minimum.persistence.branch>
        <!-- Fixed locale/time zone for every forked test JVM (unit and integration) -->
        <test.jvm.args>-Duser.timezone=UTC -Duser.language=en -Duser.country=US -Dfile.encoding=UTF-8</test.jvm.args>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!--All dependencies to put here, including module dependencies-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.postgresql/postgresql -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Stateless authentication: the session JWT is validated as an OAuth2 bearer token -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Bean Validation (Hibernate Validator): request bodies, parameters and use-case methods -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Real PostgreSQL (no Docker) for the DAO integration tests -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>${embedded-postgres.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- embedded-postgres only bundles x86-64 binaries: add the Apple Silicon ones for local runs -->
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!-- Legacy web UI, served by Spring Boot as static content -->
            <resource>
                <directory>${project.basedir}/src/main/webapp</directory>
                <targetPath>static</targetPath>
                <excludes>
                    <exclude>WEB-INF/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!-- Unit tests (*Test, Test*, *Tests): fixed locale/time zone, JaCoCo agent via @{argLine} -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${test.jvm.args}</argLine>
                </configuration>
            </plugin>
            <!--
              Code coverage. One agent (prepare-agent sets argLine) instruments both the unit tests
              (surefire) and the integration tests (failsafe); both append to target/jacoco.exec,
              so the report in target/site/jacoco (XML read by CI) is the merged unit + integration
              coverage. The report and check executions are declared before failsafe so that, in
              the verify phase, the report is still written when an integration test fails.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Thresholds: jacoco.minimum.* properties above. The second rule
                                 guards the JDBC DAOs (covered by the *IT tests) while they are
                                 migrated; move it to the new repositories' package then. -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.dragomitch.ipl.pae.persistence.implementations</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.persistence.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.persistence.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Integration tests (*IT): DAOs against an embedded PostgreSQL, reported in
                 target/failsafe-reports (the "Backend integration" suite of the CI report) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${test.jvm.args}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Spring Boot Maven plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
